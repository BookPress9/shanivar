{
  "schema_version": 1,
  "oldest_readable_version": 0,
  "pii_classes": {"none": "enum, bounded number or boolean; identifies nobody", "pseudonymous": "random app-generated id (auth uid, event/occasion/window/step id) or catalog id; links events of one install, names nobody", "quasi": "time, time zone or app version: needed for the metrics, could narrow down a person when combined, so never joined with contact data"},
  "events": [
    {"name": "app_first_opened", "owner": "Shanivar Frontend", "source": "system", "pii": "quasi",
     "trigger": "first launch after install (once per install)",
     "props": [],
     "feeds": ["activation", "time_to_first_value", "retention_w1_w4"]},
    {"name": "onboarding_step_completed", "owner": "Shanivar Frontend", "source": "initiation", "pii": "quasi",
     "trigger": "an Initiation step is completed",
     "props": [{"name": "step", "type": "enum", "values": ["welcome", "goal", "routine", "protection", "first_practice", "done"], "required": true, "pii": "none"}],
     "feeds": ["activation"]},
    {"name": "goal_selected", "owner": "Shanivar Frontend", "source": "initiation", "pii": "quasi",
     "trigger": "the user picks a primary goal (segment)",
     "props": [{"name": "segment", "type": "enum", "values": ["distraction", "routine", "meditation", "inquiry"], "required": true, "pii": "none"}],
     "feeds": ["activation"]},
    {"name": "permission_state_changed", "owner": "Shanivar Frontend", "source": "system", "pii": "quasi",
     "trigger": "a needed permission is granted or revoked (checked at start and resume)",
     "props": [{"name": "permission", "type": "enum", "values": ["usage", "overlay", "exact_alarm", "notifications", "activity"], "required": true, "pii": "none"}, {"name": "granted", "type": "bool", "required": true, "pii": "none"}],
     "feeds": ["technical_reliability"]},
    {"name": "routine_created", "owner": "Shanivar Frontend", "source": "routine", "pii": "quasi",
     "trigger": "the user saves a routine for the first time",
     "props": [{"name": "step_count", "type": "int", "min": 0, "max": 50, "required": false, "pii": "none"}, {"name": "window_count", "type": "int", "min": 0, "max": 8, "required": true, "pii": "none"}, {"name": "overnight", "type": "bool", "required": true, "pii": "none"}],
     "feeds": ["activation"]},
    {"name": "protection_window_saved", "owner": "Shanivar Frontend", "source": "routine", "pii": "quasi",
     "trigger": "a protection window is created or edited",
     "props": [{"name": "window_id", "type": "id", "required": true, "pii": "pseudonymous"}, {"name": "overnight", "type": "bool", "required": true, "pii": "none"}],
     "feeds": ["activation"]},
    {"name": "routine_step_completed", "owner": "Shanivar Frontend", "source": "routine", "pii": "quasi",
     "trigger": "the user marks a planned activity done",
     "props": [{"name": "step_id", "type": "id", "required": true, "pii": "pseudonymous"}, {"name": "scheduled_local_date", "type": "local_date", "required": true, "pii": "quasi"}, {"name": "scheduled_local_time", "type": "local_time", "required": true, "pii": "quasi"}],
     "feeds": ["wiac", "routine_completion_rate", "activation", "time_to_first_value", "retention_w1_w4", "recovery_after_missed_days"]},
    {"name": "routine_step_uncompleted", "owner": "Shanivar Frontend", "source": "routine", "pii": "quasi",
     "trigger": "the user undoes a done mark (retracts the completion)",
     "props": [{"name": "step_id", "type": "id", "required": true, "pii": "pseudonymous"}, {"name": "scheduled_local_date", "type": "local_date", "required": true, "pii": "quasi"}],
     "feeds": ["wiac", "routine_completion_rate"]},
    {"name": "routine_step_missed", "owner": "Shanivar Frontend", "source": "routine", "pii": "quasi",
     "trigger": "a planned activity's slot ends without a done mark (device-side, once per step and date)",
     "props": [{"name": "step_id", "type": "id", "required": true, "pii": "pseudonymous"}, {"name": "scheduled_local_date", "type": "local_date", "required": true, "pii": "quasi"}, {"name": "scheduled_local_time", "type": "local_time", "required": true, "pii": "quasi"}],
     "feeds": ["routine_completion_rate"]},
    {"name": "routine_recovered", "owner": "Shanivar Frontend", "source": "routine", "pii": "quasi",
     "trigger": "the first step completed after one or more missed steps",
     "props": [{"name": "missed_steps", "type": "int", "min": 1, "max": 1000, "required": true, "pii": "none"}, {"name": "gap_days", "type": "int", "min": 0, "max": 365, "required": true, "pii": "none"}],
     "feeds": ["recovery_after_missed_days"]},
    {"name": "protection_window_started", "owner": "Shanivar Frontend", "source": "protection", "pii": "quasi",
     "trigger": "a protection window becomes active",
     "props": [{"name": "window_id", "type": "id", "required": true, "pii": "pseudonymous"}, {"name": "armed_by_engine", "type": "bool", "required": true, "pii": "none"}],
     "feeds": ["technical_reliability"]},
    {"name": "protection_window_ended", "owner": "Shanivar Frontend", "source": "protection", "pii": "quasi",
     "trigger": "a protection window ends",
     "props": [{"name": "window_id", "type": "id", "required": true, "pii": "pseudonymous"}, {"name": "end_reason", "type": "enum", "values": ["scheduled", "user_stop", "failure"], "required": true, "pii": "none"}, {"name": "scheduled_minutes", "type": "int", "min": 0, "max": 1440, "required": true, "pii": "none"}, {"name": "active_minutes", "type": "int", "min": 0, "max": 1440, "required": true, "pii": "none"}],
     "feeds": ["protection_window_effectiveness", "technical_reliability", "less_dependence_signal"]},
    {"name": "protection_failure_detected", "owner": "Shanivar Frontend", "source": "protection", "pii": "quasi",
     "trigger": "enforcement stops while a window is scheduled",
     "props": [{"name": "cause", "type": "enum", "values": ["service_killed", "permission_revoked", "doze", "other"], "required": true, "pii": "none"}],
     "feeds": ["technical_reliability"]},
    {"name": "intervention_shown", "owner": "Shanivar Frontend", "source": "protection", "pii": "quasi",
     "trigger": "the block overlay is shown (mints occasion_id)",
     "props": [{"name": "window_id", "type": "id", "required": true, "pii": "pseudonymous"}, {"name": "app_category", "type": "enum", "values": ["social", "video", "games", "messaging", "browser", "shopping", "news", "other"], "required": true, "pii": "none"}],
     "feeds": ["protection_window_effectiveness", "less_dependence_signal"]},
    {"name": "intervention_choice", "owner": "Shanivar Frontend", "source": "protection", "pii": "quasi",
     "trigger": "the user picks an option on the block overlay (same occasion_id)",
     "props": [{"name": "window_id", "type": "id", "required": true, "pii": "pseudonymous"}, {"name": "app_category", "type": "enum", "values": ["social", "video", "games", "messaging", "browser", "shopping", "news", "other"], "required": true, "pii": "none"}, {"name": "choice", "type": "enum", "values": ["return", "pause", "practice", "stop_protection", "essential"], "required": true, "pii": "none"}],
     "feeds": ["wiac", "protection_window_effectiveness", "activation", "time_to_first_value", "retention_w1_w4", "recovery_after_missed_days"]},
    {"name": "practice_started", "owner": "Shanivar Frontend", "source": "sadhana", "pii": "quasi",
     "trigger": "a practice the user chose starts (mints occasion_id unless one is inherited)",
     "props": [{"name": "practice_id", "type": "id", "required": true, "pii": "pseudonymous"}, {"name": "launched_from", "type": "enum", "values": ["home", "intervention", "routine", "initiation"], "required": true, "pii": "none"}],
     "feeds": ["meditation_return_rate", "activation"]},
    {"name": "practice_ended", "owner": "Shanivar Frontend", "source": "sadhana", "pii": "quasi",
     "trigger": "a practice attempt ends (same occasion_id as its start)",
     "props": [{"name": "practice_id", "type": "id", "required": true, "pii": "pseudonymous"}, {"name": "launched_from", "type": "enum", "values": ["home", "intervention", "routine", "initiation"], "required": true, "pii": "none"}, {"name": "outcome", "type": "enum", "values": ["completed", "ended", "interrupted"], "required": true, "pii": "none"}, {"name": "active_seconds", "type": "int", "min": 0, "max": 86400, "required": true, "pii": "none"}],
     "feeds": ["wiac", "activation", "time_to_first_value", "retention_w1_w4", "recovery_after_missed_days"]},
    {"name": "self_report_submitted", "owner": "Shanivar Frontend", "source": "sadhana", "pii": "quasi",
     "trigger": "a self-report is saved (kind only; the answers stay in the user-owned record)",
     "props": [{"name": "kind", "type": "enum", "values": ["stage1_check", "independent", "reflection"], "required": true, "pii": "none"}],
     "feeds": ["wiac_sr", "activation", "self_reported_usefulness"]},
    {"name": "alarm_fired", "owner": "Shanivar Frontend", "source": "routine", "pii": "quasi",
     "trigger": "the wake alarm rings",
     "props": [{"name": "delay_seconds", "type": "int", "min": -3600, "max": 86400, "required": true, "pii": "none"}],
     "feeds": ["technical_reliability"]},
    {"name": "alarm_dismissed", "owner": "Shanivar Frontend", "source": "routine", "pii": "quasi",
     "trigger": "the wake alarm is dismissed (never a WIAC action by itself)",
     "props": [{"name": "method", "type": "enum", "values": ["movement", "qr", "photo", "accessible"], "required": true, "pii": "none"}],
     "feeds": ["activation", "technical_reliability"]},
    {"name": "app_returned_after_gap", "owner": "Shanivar Frontend", "source": "system", "pii": "quasi",
     "trigger": "the app is opened after 2+ local days without opening",
     "props": [{"name": "gap_days", "type": "int", "min": 2, "max": 3650, "required": true, "pii": "none"}],
     "feeds": ["recovery_after_missed_days"]},
    {"name": "guidance_level_changed", "owner": "Shanivar Frontend", "source": "sadhana", "pii": "quasi",
     "trigger": "the user changes the guidance level",
     "props": [{"name": "from", "type": "enum", "values": ["full", "reduced", "minimal"], "required": true, "pii": "none"}, {"name": "to", "type": "enum", "values": ["full", "reduced", "minimal"], "required": true, "pii": "none"}],
     "feeds": ["less_dependence_signal"]},
    {"name": "sync_flush_completed", "owner": "Shanivar Backend", "source": "system", "pii": "quasi",
     "trigger": "a DEV-45 outbox flush finishes (one per run)",
     "props": [{"name": "sent", "type": "int", "min": 0, "max": 10000, "required": true, "pii": "none"}, {"name": "retried", "type": "int", "min": 0, "max": 10000, "required": true, "pii": "none"}, {"name": "dead_lettered", "type": "int", "min": 0, "max": 10000, "required": true, "pii": "none"}],
     "feeds": ["technical_reliability"]},
    {"name": "sync_dead_lettered", "owner": "Shanivar Backend", "source": "system", "pii": "quasi",
     "trigger": "an outbox item is dead-lettered (no payload)",
     "props": [{"name": "kind", "type": "enum", "values": ["attempt", "self_report", "routine", "window", "orbit", "reflection", "other"], "required": true, "pii": "none"}, {"name": "error_class", "type": "enum", "values": ["http_4xx", "retry_limit", "delete_unsupported", "bad_payload", "unknown_kind", "other"], "required": true, "pii": "none"}],
     "feeds": ["technical_reliability"]},
    {"name": "feedback_submitted", "owner": "Shanivar Frontend", "source": "system", "pii": "quasi",
     "trigger": "the user sends in-app feedback (category only; the text goes to the CS channel, not analytics)",
     "props": [{"name": "category", "type": "enum", "values": ["bug", "idea", "content", "protection", "alarm", "other"], "required": true, "pii": "none"}],
     "feeds": ["cs_insights"]}
  ],
  "metrics": [
    {"id": "wiac", "brief": "North Star: Weekly Intentional Actions Completed", "events": ["routine_step_completed", "routine_step_uncompleted", "practice_ended", "intervention_choice"], "other_sources": []},
    {"id": "wiac_sr", "brief": "WIAC-SR: practised without the app (reported separately, never merged)", "events": ["self_report_submitted"], "other_sources": []},
    {"id": "activation", "brief": "Activation rate per segment", "events": ["app_first_opened", "goal_selected", "intervention_choice", "routine_created", "routine_step_completed", "alarm_dismissed", "practice_started", "practice_ended", "self_report_submitted"], "other_sources": []},
    {"id": "time_to_first_value", "brief": "Time to first value", "events": ["app_first_opened", "routine_step_completed", "practice_ended", "intervention_choice"], "other_sources": []},
    {"id": "routine_completion_rate", "brief": "Routine completion rate", "events": ["routine_step_completed", "routine_step_uncompleted", "routine_step_missed"], "other_sources": []},
    {"id": "protection_window_effectiveness", "brief": "Protection-window effectiveness (+ interventions per protected hour guardrail)", "events": ["intervention_shown", "intervention_choice", "protection_window_ended"], "other_sources": []},
    {"id": "meditation_return_rate", "brief": "Meditation return rate (second distinct local day within 7 days)", "events": ["practice_started"], "other_sources": []},
    {"id": "retention_w1_w4", "brief": "W1 / W4 retention (qualifying action, not an app open)", "events": ["app_first_opened", "routine_step_completed", "practice_ended", "intervention_choice"], "other_sources": []},
    {"id": "recovery_after_missed_days", "brief": "Recovery after missed days", "events": ["routine_step_completed", "practice_ended", "intervention_choice", "routine_recovered", "app_returned_after_gap"], "other_sources": []},
    {"id": "self_reported_usefulness", "brief": "Self-reported intentionality and usefulness (distribution, never a score)", "events": ["self_report_submitted"], "other_sources": ["practice_reflections.usefulness (user-owned record, DEV-54)", "intentionality question record (Epic G, not built)"]},
    {"id": "technical_reliability", "brief": "Technical reliability (alarm on time, protection active while scheduled, sync)", "events": ["alarm_fired", "protection_window_started", "protection_window_ended", "protection_failure_detected", "permission_state_changed", "sync_flush_completed", "sync_dead_lettered"], "other_sources": ["crash-free sessions: crash reporting (DEV-14), not an analytics event"]},
    {"id": "less_dependence_signal", "brief": "Guardrail: needs less intervention over time (interventions per protected hour with stable WIAC)", "events": ["intervention_shown", "protection_window_ended", "guidance_level_changed"], "other_sources": []}
  ]
}
