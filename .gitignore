# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
out/
dist/
build/

# Environment files (never commit secrets). Broadened after backend/.env was found
# committed and pushed in this repo's predecessor — match every .env variant and
# opt specific safe templates back in, rather than listing variants one at a time.
.env
.env.*
!.env.example
!.env.template
!*.env.example
!*.env.template

# Android build outputs and signing material
.gradle/
local.properties
*.apk
*.aab
*.keystore
*.jks
captures/
.externalNativeBuild/
.cxx/

# Archived material from earlier project phases — contains live credentials
# (a Render API key, old production env files) and a nested git repo.
archive_deployment/
archive_auxiliary/

# Marketing working directory: 115MB of video/image assets and a bundled ffmpeg
# binary. The strategy documents in it are tracked explicitly instead.
marketing/shanivar/*
!marketing/shanivar/*.md

