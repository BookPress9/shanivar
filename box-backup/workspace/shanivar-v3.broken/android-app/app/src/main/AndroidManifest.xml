<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ===== Discipline Engine: app-lockout ===== -->
    <!-- Special access granted once via a Settings deep link (ACTION_USAGE_ACCESS_SETTINGS), never
         a runtime dialog. Lets FocusGuardService read which app is currently in the foreground via
         UsageStatsManager, to detect a blocked package during an active focus session. This is the
         policy-accepted mechanism platform-research.md recommends in place of AccessibilityService
         (whose autonomous "app blocking" use is a real 2026 Play Store rejection/suspension risk). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Special access granted once via a Settings deep link (ACTION_MANAGE_OVERLAY_PERMISSION),
         never a runtime dialog. Two jobs: (1) it's what actually lets BlockOverlayActivity/
         AlarmActivity present a screen over whatever the user is currently in, and (2) holding it
         is what exempts FocusGuardService (a background Service) from Android 10+'s restriction on
         starting Activities from the background - without it, startActivity() from the service
         would silently fail on many OS versions. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Sadhana focus lock: silence pop-ups via DND only if the user grants access. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Normal manifest permission (no dialog, no Settings step); required by the OS to run any
         foreground service at all on API 28+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+ requires every foreground service to declare a type, and that type's matching
         permission. Neither "watch for a blocked app" nor "keep an alarm screen alive" has a
         dedicated FGS type in the current Android SDK, so both of this feature's services declare
         foregroundServiceType="specialUse" below and use this permission + a per-service
         PROPERTY_SPECIAL_USE_FGS_SUBTYPE justification, which Play Console review will evaluate.
         This is one of the fastest-moving parts of Android policy - re-verify against current
         Play Console Help docs before submitting, per platform-research.md's own caveat. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- ===== Discipline Engine: alarm ===== -->
    <!-- On API 31-32 this needs no user action (granted at install); on API 33+ it becomes an
         "Alarms & reminders" toggle in Settings the user can revoke at any time, which must be
         re-checked via AlarmManager.canScheduleExactAlarms() on every resume (see
         DisciplinePermissions.hasExactAlarmPermission() and NATIVE_HANDOFF.md's "returning from
         Android settings must re-read permission status" rule). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- USE_EXACT_ALARM is the alternative for apps whose core purpose is alarms/clocks: it is
         granted automatically with no Settings toggle at all, but Play Console restricts it to
         apps that qualify and clearly declare that purpose. Declaring both means the app degrades
         to the Settings-toggle path (SCHEDULE_EXACT_ALARM) if review does not accept the stricter
         one for this app. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Lets AlarmFireReceiver's notification auto-launch AlarmActivity over the lock screen via
         setFullScreenIntent. Android 14+ auto-revokes this for apps without a completed Play
         Console "core functionality: alarms" declaration - that declaration must be completed
         before this is relied on in production. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- AlarmManager entries do not survive a reboot; this lets BootRescheduleReceiver restore a
         still-future pending alarm after the device restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Runtime-dialog permission on API 33+. Needed for the foreground-service and alarm
         notifications to actually be visible to the user; the services still run without it, they
         just post no visible notification (Codex's onboarding UI is expected to request this). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Standard runtime-dialog permission for both dismissal methods' CameraX preview/capture. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- An alarm has to make an alarm sound. Until 2026-09-12 this app had neither of these:
         the only audio was whatever default notification tone the channel happened to use, at
         notification volume, which Do Not Disturb silences - so the alarm could not reliably
         wake anyone. AlarmRinger plays on the ALARM stream and vibrates; WAKE_LOCK keeps the
         CPU up between the broadcast firing and the alarm screen appearing, which Doze would
         otherwise be free to defer. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.twitter.android" />
        <package android:name="com.snapchat.android" />
    </queries>

    <application android:label="Shanivar" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>

        <!-- Launched by FocusGuardService (see its SYSTEM_ALERT_WINDOW comment above) when a
             blocked package is detected in the foreground during an active session. -->
        <activity android:name=".BlockOverlayActivity" android:exported="false"
            android:excludeFromRecents="true" android:launchMode="singleInstance" />

        <!-- Launched by AlarmFireReceiver's full-screen intent; stays on top over the lock screen
             until a dismissal method reports verified success. -->
        <activity android:name=".AlarmActivity" android:exported="false"
            android:excludeFromRecents="true" android:launchMode="singleInstance" />
        <activity android:name=".QrDismissalActivity" android:exported="false" />
        <activity android:name=".PhotoMotionDismissalActivity" android:exported="false" />
        <activity android:name=".MovementDismissalActivity" android:exported="false" />

        <!-- foregroundServiceType/PROPERTY_SPECIAL_USE_FGS_SUBTYPE: see the
             FOREGROUND_SERVICE_SPECIAL_USE permission comment above. -->
        <service android:name=".FocusGuardService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Detects and blocks a user-selected distracting app during a focus session the user started" />
        </service>
        <service android:name=".AlarmForegroundService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the full-screen wake-up alarm activity alive until the user completes verified dismissal" />
        </service>

        <receiver android:name=".AlarmFireReceiver" android:exported="false" />
        <!-- Fires at a recurring focus schedule's next start/end boundary - see FocusScheduler. -->
        <receiver android:name=".FocusScheduleReceiver" android:exported="false" />
        <receiver android:name=".BootRescheduleReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
