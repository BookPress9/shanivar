<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 1 scaffold — placeholder layout for the native (non-WebView) alarm
  screen. Colors reference the Saturn/discipline palette defined in
  ../../../../../visual-identity.md (sv_void background, sv_signal_amber for
  the active countdown — per that doc, amber is reserved exclusively for
  live discipline-critical states, which this screen is the canonical one).
  Real dismissal-verification UI (QR scan / puzzle / movement) replaces the
  placeholder TextViews once Discipline Engine Agent's design lands.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/sv_void"
    android:padding="32dp">

    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alarm_title"
        android:textColor="@color/sv_bone"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:id="@+id/alarm_instruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/alarm_instruction_placeholder"
        android:textColor="@color/sv_signal_amber"
        android:textSize="16sp"
        android:gravity="center" />

</LinearLayout>
