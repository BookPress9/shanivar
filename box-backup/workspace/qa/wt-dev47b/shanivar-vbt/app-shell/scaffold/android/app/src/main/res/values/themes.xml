<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme.Saturn" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/sv_void</item>
        <item name="colorPrimary">@color/sv_ring_gold</item>
        <item name="colorAccent">@color/sv_signal_amber</item>
        <item name="android:textColor">@color/sv_bone</item>
    </style>

    <!-- MainActivity theme — hosts the WebView; kept minimal since the web
         content (frontend/src/app/globals.css) governs the actual UI palette
         once the page loads. This only controls the brief native splash/
         boot background so there's no white flash before the WebView paints. -->
    <style name="AppTheme.Saturn.NoActionBar" parent="AppTheme.Saturn" />

    <!-- Native alarm screen theme — see visual-identity.md §1/§4. Amber is
         reserved exclusively for this kind of live discipline-critical state. -->
    <style name="AppTheme.Saturn.Alarm" parent="AppTheme.Saturn">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/sv_void</item>
    </style>

</resources>
